# =============================================================================
# AGENT BUILDER MIGRATION TOOL - ENVIRONMENT VARIABLES
# =============================================================================
# This file contains configuration for migrating Agent Builder configurations
# between Elasticsearch Serverless clusters.
#
# Copy this file to .env and fill in your actual values.
# =============================================================================

# =============================================================================
# SOURCE CLUSTER CONFIGURATION
# =============================================================================
# The cluster from which to export the agent and tools

# [REQUIRED] Source Kibana URL (e.g., https://your-source.kb.us-central1.gcp.cloud.es.io)
SOURCE_KIBANA_URL=https://your-source-kibana.elastic.co

# [REQUIRED] Source cluster API key with read permissions for Agent Builder
SOURCE_API_KEY=your-source-api-key

# [REQUIRED] ID of the agent to export
AGENT_ID=your-agent-id

# =============================================================================
# TARGET CLUSTER CONFIGURATION
# =============================================================================
# The cluster to which to import the agent and tools

# [REQUIRED] Target Kibana URL (e.g., https://your-target.kb.us-central1.gcp.cloud.es.io)
TARGET_KIBANA_URL=https://your-target-kibana.elastic.co

# [REQUIRED] Target cluster API key with write permissions for Agent Builder
TARGET_API_KEY=your-target-api-key

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# [OPTIONAL] Skip platform tools (default: true)
# Set to false to include platform tools in the migration
SKIP_PLATFORM_TOOLS=true

# [OPTIONAL] Logging level (debug, info, warning, error)
LOG_LEVEL=info

# [OPTIONAL] Request timeout in seconds
REQUEST_TIMEOUT=30
