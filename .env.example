# =============================================================================
# NBA Commentary System - Docker Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# =============================================================================
# ELASTICSEARCH & KIBANA (REQUIRED)
# =============================================================================
ELASTICSEARCH_URL=https://your-cluster.elastic.co
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key
KIBANA_URL=https://your-kibana.elastic.co

# =============================================================================
# ANTHROPIC CLAUDE API (REQUIRED for LLM Router)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# LLM ROUTER CONFIGURATION
# =============================================================================
# Which LLM router to use
USE_LLM_ROUTER=true
USE_LLM_ADVANCED_ROUTER=false

# LLM model configuration
LLM_ROUTER_MODEL=claude-sonnet-4-20250514
LLM_ADVANCED_ROUTER_MODEL=claude-sonnet-4-20250514
LLM_ROUTER_MAX_TOKENS=2000
LLM_ADVANCED_ROUTER_MAX_TOKENS=1800
LLM_ADVANCED_ROUTER_TEMPERATURE=0.3

# =============================================================================
# BALLDONTLIE NBA API (REQUIRED)
# =============================================================================
# Get API key from: https://www.balldontlie.io/
BALLDONTLIE_API_KEY=your-balldontlie-api-key
BALLDONTLIE_API_BASE_URL=https://api.balldontlie.io/v1
BALLDONTLIE_API_TIMEOUT_MS=10000
BALLDONTLIE_TEAMS_PER_PAGE=100

# =============================================================================
# SENTIMENT MCP SERVER (OPTIONAL)
# =============================================================================
USE_SENTIMENT_MCP_SERVER=true

# TwitterAPI.io Integration (Optional - will use mock data if not provided)
# Get API key from: https://twitterapi.io
# Pricing: $0.15 per 1,000 tweets (pay-as-you-go, no monthly fees)
TWITTERAPI_API_KEY=
TWITTERAPI_PROXY_URL=  # Optional: enterprise proxy URL
TWITTER_SENTIMENT_SERVICE=true

# Reddit API (Optional - will use mock data if not provided)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_APP_NAME=

# Sentiment analysis configuration
SENTIMENT_WINDOW_MINUTES=180
SENTIMENT_MAX_SAMPLES=50

# =============================================================================
# MCP AGGREGATOR CONFIGURATION
# =============================================================================
USE_NBA_MCP_SERVER=false
MCP_CACHE_MAX_SIZE=500
MCP_CACHE_TTL_MS=300000
CODE_EXECUTOR_TIMEOUT_MS=2000

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# WebSocket URL for frontend to connect to backend
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_WS_RECONNECT_DELAY_MS=3000

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
PYTHON_BACKEND=http://a2a-backend:3002
AGENTS_API_TIMEOUT_MS=5000
QUERY_API_TIMEOUT_MS=120000
WORD_STREAMING_DELAY_MS=20

# =============================================================================
# A2A BACKEND (OPTIONAL - only needed if using --profile full)
# =============================================================================
# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Elastic Agent Builder A2A
ELASTIC_STATS_AGENT_URL=
ELASTIC_MEDIA_AGENT_URL=
ELASTIC_API_KEY=

# =============================================================================
# DATA INGESTION (OPTIONAL - only needed if using --profile ingestion)
# =============================================================================
# NBA Season
NBA_CURRENT_SEASON=2024-25

# Elasticsearch Index Names
ES_INDEX_GAME_SCHEDULE=nba-game-schedule
ES_INDEX_LIVE_GAMES=nba-live-games
ES_INDEX_PLAYER_STATS=nba-player-stats
ES_INDEX_GAME_LOGS=nba-player-game-logs

# Bulk Ingestion Settings
ES_BULK_CHUNK_SIZE=100
ES_BULK_CHUNK_SIZE_GAME_LOGS=500
ES_BULK_CHUNK_SIZE_PLAYER_STATS=500

# Live Games Configuration
LIVE_GAMES_UPDATE_INTERVAL_SECONDS=30
